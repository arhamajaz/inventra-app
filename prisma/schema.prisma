generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("Consumer")
  customerId    String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id                  String   @id @map("_id")
  name                String
  category            String
  stock               Int
  capacity            Int
  threshold           Int
  price               Float
  imageUrl            String
  historicalSalesData Sale[]
  description         String?
}

type Sale {
  date     String
  quantity Int
}

model Customer {
  id    String @id @map("_id")
  name  String
  email String @unique
}

model Order {
  id           String      @id @map("_id")
  customerName String
  customerId   String?
  items        OrderItem[]
  status       String
  date         String
}

type OrderItem {
  productName String
  quantity    Int
}

model AiUsage {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String?  @db.ObjectId
  modelName        String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  action           String
  timestamp        DateTime @default(now())
}

model AiPrompt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  prompt    String
  updatedAt DateTime @updatedAt
}
